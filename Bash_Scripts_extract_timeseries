#!/bin/bash

BASE_DIR="$(pwd)"

echo "============================================================"
echo "ROI EXTRACTION"
echo "Directory: $BASE_DIR"
echo "Skipping: subject_01, subject_09, subject_35"
echo "============================================================"

# Check required commands
if ! command -v flirt >/dev/null 2>&1; then
    echo "ERROR: FSL/FLIRT is not available."
    echo "Please load/source your FSL installation first."
    exit 1
fi

if ! command -v fslmeants >/dev/null 2>&1; then
    echo "ERROR: fslmeants is not available."
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: python3 is not available."
    exit 1
fi

# ------------------------------------------------------------
# Process every subject
# ------------------------------------------------------------

for SUBJECT_DIR in "$BASE_DIR"/subject_*; do

    [ -d "$SUBJECT_DIR" ] || continue

    SUBJECT=$(basename "$SUBJECT_DIR")

    # Skip subjects 1, 9 and 35
    case "$SUBJECT" in
        subject_1|subject_01|subject_9|subject_09|subject_35)
            echo ""
            echo "******** SKIPPING $SUBJECT ********"
            continue
            ;;
    esac

    echo ""
    echo "============================================================"
    echo "SUBJECT: $SUBJECT"
    echo "============================================================"

    # --------------------------------------------------------
    # Find every Task directory
    # --------------------------------------------------------

    for TASK_DIR in "$SUBJECT_DIR"/Task*; do

        [ -d "$TASK_DIR" ] || continue

        TASK=$(basename "$TASK_DIR")

        echo ""
        echo "------------------------------------------------------------"
        echo "Processing: $SUBJECT / $TASK"
        echo "------------------------------------------------------------"

        ATLAS="$TASK_DIR/atlas.nii.gz"
        FUNC="$TASK_DIR/denoised_data.nii.gz"

        REGISTERED_ATLAS="$TASK_DIR/atlas2func.nii.gz"
        MATRIX="$TASK_DIR/atlas2func.mat"
        RESAMPLED_ATLAS="$TASK_DIR/atlas_resampled.nii.gz"
        TIMESERIES="$TASK_DIR/all_rois_timeseries.txt"
        MATFILE="$TASK_DIR/all_rois_timeseries_${TASK}_raw.mat"

        # ----------------------------------------------------
        # Check files
        # ----------------------------------------------------

        if [ ! -f "$ATLAS" ]; then
            echo "WARNING: atlas.nii.gz missing"
            echo "Skipping $SUBJECT / $TASK"
            continue
        fi

        if [ ! -f "$FUNC" ]; then
            echo "WARNING: denoised_data.nii.gz missing"
            echo "Skipping $SUBJECT / $TASK"
            continue
        fi

        # ----------------------------------------------------
        # STEP 1: Estimate transformation
        # ----------------------------------------------------

        echo "[1/4] FLIRT registration..."

        flirt \
            -in "$ATLAS" \
            -ref "$FUNC" \
            -out "$REGISTERED_ATLAS" \
            -omat "$MATRIX" \
            -dof 6 \
            -interp nearestneighbour

        if [ $? -ne 0 ]; then
            echo "ERROR: FLIRT registration failed"
            echo "Skipping $SUBJECT / $TASK"
            continue
        fi

        # ----------------------------------------------------
        # STEP 2: Apply transformation
        # ----------------------------------------------------

        echo "[2/4] Applying transformation..."

        flirt \
            -in "$ATLAS" \
            -ref "$FUNC" \
            -applyxfm \
            -init "$MATRIX" \
            -interp nearestneighbour \
            -out "$RESAMPLED_ATLAS"

        if [ $? -ne 0 ]; then
            echo "ERROR: Transformation failed"
            echo "Skipping $SUBJECT / $TASK"
            continue
        fi

        # ----------------------------------------------------
        # STEP 3: Extract ROI time series
        # ----------------------------------------------------

        echo "[3/4] Extracting ROI time series..."

        fslmeants \
            -i "$FUNC" \
            -o "$TIMESERIES" \
            --label="$RESAMPLED_ATLAS"

        if [ $? -ne 0 ]; then
            echo "ERROR: fslmeants failed"
            echo "Skipping $SUBJECT / $TASK"
            continue
        fi

        # ----------------------------------------------------
        # STEP 4: Convert TXT to MATLAB .mat
        # ----------------------------------------------------

        echo "[4/4] Creating MATLAB file..."

        python3 - "$TIMESERIES" "$MATFILE" "$TASK" <<'PYTHON'
import sys
import numpy as np
from scipy.io import savemat

txt_file = sys.argv[1]
mat_file = sys.argv[2]
task = sys.argv[3]

try:
    data = np.loadtxt(txt_file)

    # Make sure 1-dimensional data is represented consistently
    if data.ndim == 1:
        data = data.reshape(-1, 1)

    savemat(mat_file, {task: data})

    print("Saved:", mat_file)
    print("Dimensions:", data.shape)

except Exception as e:
    print("ERROR converting file:", e)
    sys.exit(1)
PYTHON

        if [ $? -ne 0 ]; then
            echo "ERROR: MATLAB conversion failed"
            continue
        fi

        echo "SUCCESS: $SUBJECT / $TASK"

    done

done

echo ""
echo "============================================================"
echo "FINISHED"
echo "============================================================"
echo "Processed subjects except:"
echo "  subject_01"
echo "  subject_09"
echo "  subject_35"
echo "============================================================"



