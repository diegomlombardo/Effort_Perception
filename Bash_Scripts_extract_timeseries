% ============================================================
% TASK 1 - Z-SCORE
% ============================================================

load('all_rois_timeseries_Task1_raw.mat', 'Task1');

% Z-score each column (ROI)
Task1_z = zeros(size(Task1));

for roi = 1:size(Task1,2)

    % Values for this ROI
    x = Task1(:,roi);

    % Handle NaNs using column median
    nan_idx = isnan(x);

    if any(nan_idx)
        x(nan_idx) = median(x(~nan_idx));
    end

    % Column-wise z-score
    mu = mean(x);
    sigma = std(x);

    if sigma == 0
        Task1_z(:,roi) = zeros(size(x));
    else
        Task1_z(:,roi) = (x - mu) ./ sigma;
    end

end

% Save z-scored Task 1
save('all_rois_timeseries_Task1_zscore.mat', 'Task1_z');

fprintf('Saved all_rois_timeseries_Task1_zscore.mat\n');
fprintf('Dimensions: %d x %d\n', size(Task1_z,1), size(Task1_z,2));

