% Z-score each column (ROI)
Task1_z = zeros(size(Task1));

for roi = 1:size(Task1,2)

    % Values for this ROI
    x = Task1(:,roi);

    % Handle NaNs using column median
    nan_idx = isnan(x);

    if any(nan_idx)
        x(nan_idx) = median(x(~nan_idx));
    end

    % Column-wise z-score
    mu = mean(x);
    sigma = std(x);

    Task1_z(:,roi) = (x - mu) ./ sigma;
end

% Save the result
save('all_rois_timeseries_zscore.mat', 'Task1_z');
