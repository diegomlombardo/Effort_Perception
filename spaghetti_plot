%% ============================================================
% M1 SPAGHETTI PLOT — INB
%
% M1 = ROI 7 — Precentral Gyrus
%
% DATA:
%   184 BOLD time points
%   TR = 2.5 seconds
%
% TASK:
%   Initial rest       = 17 seconds
%   Movement           = 15 seconds
%   Rest               = 25 seconds
%   Number movements   = 12
%
% OUTLIER REMOVAL:
%   Subject-level MAD based on mean BOLD activity
%   PLUS temporal-spike MAD detection
%
% IMPORTANT:
%   Outlier subjects are completely excluded from:
%       1. spaghetti lines
%       2. group mean
%       3. y-axis calculation
%
% FIGURE:
%   Green shading = Movement period
%   Gray shading  = Rest period
%
%   No "plot()" function is used.
%   Curves are drawn with "line()".
%
% ============================================================


%% ============================================================
% 1. ROI
% ============================================================

M1_ROI = 7;

roi_name = 'M1 - Precentral Gyrus';


%% ============================================================
% 2. TIME PARAMETERS
% ============================================================

TR = 2.5;

total_time_points = 184;


%% ============================================================
% 3. TASK PARAMETERS
% ============================================================

initial_rest_sec = 17;

movement_sec = 15;

interblock_rest_sec = 25;

num_movements = 12;


% Convert task durations to acquired TRs

initial_rest_TRs = ...
    round(initial_rest_sec / TR);

movement_TRs = ...
    round(movement_sec / TR);

interblock_rest_TRs = ...
    round(interblock_rest_sec / TR);


%% ============================================================
% 4. OUTLIER PARAMETERS
% ============================================================

outlier_threshold = 3.0;


%% ============================================================
% 5. SUBJECT LIST
% ============================================================

if ~exist('valid_subjects','var')

    missing_subjects = [1 9 35];

    total_subjects = 47;

    valid_subjects = ...
        setdiff(1:total_subjects,missing_subjects);

end


num_subjects = ...
    length(valid_subjects);


%% ============================================================
% 6. LOAD DATA
% ============================================================

fprintf('\n');
fprintf('============================================\n');
fprintf('LOADING M1 DATA — INB\n');
fprintf('============================================\n');


all_data = cell(num_subjects,1);


for s = 1:num_subjects


    subj = valid_subjects(s);


    %% --------------------------------------------------------
    % Subject string
    % ---------------------------------------------------------

    if subj < 10

        subj_str = ...
            ['0' num2str(subj)];

    else

        subj_str = ...
            num2str(subj);

    end


    %% --------------------------------------------------------
    % Filename
    % ---------------------------------------------------------

    filename = ...
        ['ROIs_sub_' subj_str '_task2.mat'];


    fprintf( ...
        'Loading subject %d: %s\n', ...
        subj, ...
        filename ...
        );


    %% --------------------------------------------------------
    % Check file
    % ---------------------------------------------------------

    if ~isfile(filename)

        error( ...
            ['File not found: ' filename] ...
            );

    end


    %% --------------------------------------------------------
    % Load
    % ---------------------------------------------------------

    loaded = ...
        load(filename);


    %% --------------------------------------------------------
    % Check bold_data
    % ---------------------------------------------------------

    if ~isfield(loaded,'bold_data')

        error( ...
            ['bold_data not found in ' filename] ...
            );

    end


    current_data = ...
        loaded.bold_data;


    %% --------------------------------------------------------
    % Check ROI number
    % ---------------------------------------------------------

    if size(current_data,2) ~= 48

        error( ...
            ['Subject %d has %d ROIs. ' ...
             'Expected 48.'], ...
             subj, ...
             size(current_data,2) ...
             );

    end


    %% --------------------------------------------------------
    % CRITICAL:
    % EXACTLY 184 TIME POINTS
    % ---------------------------------------------------------

    if size(current_data,1) ~= total_time_points

        error( ...
            ['Subject %d has %d time points. ' ...
             'Expected exactly 184.'], ...
             subj, ...
             size(current_data,1) ...
             );

    end


    %% --------------------------------------------------------
    % Store
    % ---------------------------------------------------------

    all_data{s} = ...
        current_data;


end


fprintf('\n');

fprintf( ...
    'All subjects loaded.\n' ...
    );

fprintf( ...
    'Number of subjects: %d\n', ...
    num_subjects ...
    );

fprintf( ...
    'Number of BOLD time points: %d\n', ...
    total_time_points ...
    );


%% ============================================================
% 7. EXTRACT M1 TIME SERIES
% ============================================================

% Rows = 184 BOLD time points
%
% Columns = subjects

all_subjects_ts = ...
    NaN(total_time_points,num_subjects);


for s = 1:num_subjects

    all_subjects_ts(:,s) = ...
        all_data{s}(:,M1_ROI);

end


%% ============================================================
% 8. SUBJECT-LEVEL MEAN BOLD ACTIVITY
% ============================================================

subject_mean = ...
    NaN(1,num_subjects);


for s = 1:num_subjects


    current_values = ...
        all_subjects_ts(:,s);


    current_values = ...
        current_values(~isnan(current_values));


    if ~isempty(current_values)

        subject_mean(s) = ...
            mean(current_values);

    end

end


%% ============================================================
% 9. MAD OUTLIER DETECTION — SUBJECT MEAN
% ============================================================

valid_means = ...
    subject_mean(~isnan(subject_mean));


median_mean = ...
    median(valid_means);


absolute_deviation_mean = ...
    abs(valid_means - median_mean);


mean_MAD = ...
    median(absolute_deviation_mean);


mean_outliers = ...
    false(1,num_subjects);


if mean_MAD > 0


    modified_z_mean = ...
        0.6745 .* ...
        (subject_mean - median_mean) ./ ...
        mean_MAD;


    mean_outliers = ...
        abs(modified_z_mean) > ...
        outlier_threshold;

end


%% ============================================================
% 10. TEMPORAL MEDIAN TIME SERIES
% ============================================================

% Median across subjects at every TR

temporal_median = ...
    NaN(total_time_points,1);


for t = 1:total_time_points


    values = ...
        all_subjects_ts(t,:);


    values = ...
        values(~isnan(values));


    if ~isempty(values)

        temporal_median(t) = ...
            median(values);

    end

end


%% ============================================================
% 11. SUBJECT MAXIMUM TEMPORAL DEVIATION
% ============================================================

subject_max_deviation = ...
    NaN(1,num_subjects);


for s = 1:num_subjects


    deviations = ...
        abs( ...
            all_subjects_ts(:,s) - ...
            temporal_median ...
            );


    deviations = ...
        deviations(~isnan(deviations));


    if ~isempty(deviations)

        subject_max_deviation(s) = ...
            max(deviations);

    end

end


%% ============================================================
% 12. MAD OUTLIER DETECTION — TEMPORAL SPIKES
% ============================================================

valid_max_deviation = ...
    subject_max_deviation( ...
        ~isnan(subject_max_deviation) ...
        );


median_max_deviation = ...
    median(valid_max_deviation);


max_deviation_MAD = ...
    median( ...
        abs( ...
            valid_max_deviation - ...
            median_max_deviation ...
            ) ...
        );


temporal_outliers = ...
    false(1,num_subjects);


if max_deviation_MAD > 0


    modified_z_temporal = ...
        0.6745 .* ...
        ( ...
        subject_max_deviation - ...
        median_max_deviation ...
        ) ./ ...
        max_deviation_MAD;


    temporal_outliers = ...
        abs(modified_z_temporal) > ...
        outlier_threshold;

end


%% ============================================================
% 13. FINAL OUTLIER CLASSIFICATION
% ============================================================

% A subject is excluded if it is:
%
%   1. an outlier according to mean BOLD activity
%
% OR
%
%   2. an outlier because of an extreme temporal spike

outlier_subjects = ...
    mean_outliers | temporal_outliers;


num_outliers = ...
    sum(outlier_subjects);


num_remaining = ...
    sum(~outlier_subjects);


%% ============================================================
% 14. REPORT OUTLIERS
% ============================================================

fprintf('\n');
fprintf('============================================\n');
fprintf('M1 OUTLIER DETECTION\n');
fprintf('============================================\n');

fprintf( ...
    'ROI: %d (%s)\n', ...
    M1_ROI, ...
    roi_name ...
    );

fprintf( ...
    'MAD threshold: %.2f\n', ...
    outlier_threshold ...
    );


if any(outlier_subjects)


    fprintf('\nSubjects removed:\n');


    for s = 1:num_subjects


        if outlier_subjects(s)


            fprintf( ...
                'Subject %d', ...
                valid_subjects(s) ...
                );


            if mean_outliers(s)

                fprintf(' [mean MAD]');

            end


            if temporal_outliers(s)

                fprintf(' [temporal spike MAD]');

            end


            fprintf('\n');


        end

    end


else


    fprintf('\nNo outlier subjects detected.\n');


end


%% ============================================================
% 15. REMOVE OUTLIER SUBJECTS
% ============================================================

% ONLY NON-OUTLIER SUBJECTS REMAIN

cleaned_data = ...
    all_subjects_ts(:,~outlier_subjects);


%% ============================================================
% 16. GROUP MEAN
% ============================================================

% Group mean is calculated ONLY from retained subjects.

group_mean = ...
    NaN(total_time_points,1);


for t = 1:total_time_points


