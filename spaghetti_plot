    initial_rest_end + 1;


%% ============================================================
% 20. 12 MOVEMENT PERIODS
% ============================================================

for c = 1:num_movements


    %% --------------------------------------------------------
    % Movement period
    % ---------------------------------------------------------

    if current_TR > total_time_points

        break;

    end


    movement_start = ...
        current_TR;


    movement_end = ...
        min( ...
            current_TR + movement_TRs - 1, ...
            total_time_points ...
            );


    contraction_mask( ...
        movement_start:movement_end ...
        ) = true;


    current_TR = ...
        movement_end + 1;


    %% --------------------------------------------------------
    % Rest after movement
    % ---------------------------------------------------------

    if c < num_movements && ...
       current_TR <= total_time_points


        rest_start = ...
            current_TR;


        rest_end = ...
            min( ...
                current_TR + ...
                interblock_rest_TRs - 1, ...
                total_time_points ...
